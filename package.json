{
  "name": "patwork",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "build": "dotenv -v NODE_ENV=production -- turbo build",
    "dev": "dotenv -- turbo dev",
    "dev:patstore": "dotenv -- turbo dev --filter=patstore",
    "dev:patflow": "dotenv -- turbo dev --filter=patflow",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "typecheck:ci": "turbo typecheck --filter=@repo/provider",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-deps": "manypkg check",
    "syncpack:check": "syncpack lint",
    "gen": "turbo gen",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@manypkg/cli": "^0.23.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^7.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "syncpack": "^15.3.3",
    "turbo": "latest",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@9.6.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@apollo/client-integration-nextjs": "^0.14.5"
  }
}
